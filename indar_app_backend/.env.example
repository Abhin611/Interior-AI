# Copy to .env and fill in your own values. Never commit .env.
APP_NAME=Indar
APP_ENV=development

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_URL=https://YOUR_PROJECT.supabase.co/storage/v1

# Postgres connection (Supabase -> Connect -> Session pooler), async driver
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# ComfyUI server that runs the img2img workflow (Dreamshaper 8 checkpoint)
COMFYUI_URL=http://127.0.0.1:8188
